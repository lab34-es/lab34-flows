{
  /* The browser application. */
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    /* Vite compiles each module in isolation and emits nothing through tsc. */
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,

    /* Type checking. `strict` is on; noImplicitAny stays off for now, exactly
       as in the package's own tsconfig -- the components came from JSX with no
       prop types, and annotating every one of them `any` would assert nothing.
       See the note in ../tsconfig.json. */
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
