---
/**
 * A screenshot that follows the site theme: the light capture is shown in
 * light mode, the dark capture in dark mode. Both are lazy-loaded, and the
 * hidden one has no box, so the browser only fetches the visible variant.
 *
 * The whole thing is a button: pressing it opens the full-size capture of the
 * current theme in the page's lightbox (see the dialog in index.astro).
 */
import { Image } from 'astro:assets';

const { light, dark, alt, widths, sizes } = Astro.props;
---

<button
  type="button"
  class="fl-shot fl-shot-open"
  data-full-light={light.src}
  data-full-dark={dark.src}
  data-alt={alt}
  aria-label={`Enlarge: ${alt}`}
>
  <Image src={light} alt={alt} widths={widths} sizes={sizes} class="fl-shot-img fl-shot-light" />
  <Image src={dark} alt={alt} widths={widths} sizes={sizes} class="fl-shot-img fl-shot-dark" />
  <span class="fl-shot-zoom" aria-hidden="true">enlarge ⤢</span>
</button>
