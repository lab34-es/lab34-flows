---
/**
 * A screenshot that follows the site theme: the light capture is shown in
 * light mode, the dark capture in dark mode. Both are lazy-loaded, and the
 * hidden one has no box, so the browser only fetches the visible variant.
 */
import { Image } from 'astro:assets';

const { light, dark, alt, widths, sizes } = Astro.props;
---

<div class="overflow-hidden rounded-xl border border-border bg-card shadow-xs">
  <Image src={light} alt={alt} widths={widths} sizes={sizes} class="w-full dark:hidden" />
  <Image src={dark} alt={alt} widths={widths} sizes={sizes} class="hidden w-full dark:block" />
</div>
