<button id="theme-toggle" type="button" aria-label="Switch color theme" class="fl-btn-ghost">
  <span class="fl-theme-to-dark">● dark</span>
  <span class="fl-theme-to-light">○ light</span>
</button>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  });
</script>
