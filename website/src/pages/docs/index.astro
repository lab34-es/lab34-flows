---
import DocsLayout from '../../layouts/DocsLayout.astro';
import Icon from '../../components/Icon.astro';
import { groupedTopics, withBase } from '../../lib/help.js';
---

<DocsLayout
  title="Documentation — lab34-flows"
  description="Everything about writing, running and integrating lab34-flows: the same articles the tool ships in its Help section."
>
  <header class="mb-10">
    <h1 class="text-3xl font-semibold tracking-tight">Documentation</h1>
    <p class="mt-3 max-w-2xl text-muted-foreground">
      These are the same articles the tool ships in its built-in Help section —
      published straight from the source, so the website and the app never
      disagree.
    </p>
  </header>

  <div class="space-y-10">
    {
      groupedTopics.map((category) => (
        <section>
          <h2 class="mb-4 text-lg font-semibold tracking-tight">
            {category.label}
          </h2>
          <div class="grid gap-3 sm:grid-cols-2">
            {category.topics.map((topic) => (
              <a
                href={withBase(`/docs/${topic.id}/`)}
                class="group rounded-xl border border-border bg-card p-4 shadow-xs transition-colors hover:bg-accent/40"
              >
                <div class="flex items-center gap-2.5">
                  <span class="flex size-7 items-center justify-center rounded-md bg-muted text-foreground">
                    <Icon name={topic.icon} class="size-3.5" />
                  </span>
                  <span class="font-medium group-hover:underline group-hover:underline-offset-4">
                    {topic.title}
                  </span>
                </div>
                <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
                  {topic.summary}
                </p>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</DocsLayout>
