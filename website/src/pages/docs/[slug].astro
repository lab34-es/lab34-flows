---
import DocsLayout from '../../layouts/DocsLayout.astro';
import Icon from '../../components/Icon.astro';
import { orderedTopics, withBase } from '../../lib/help.js';
import { renderMarkdown } from '../../lib/markdown.js';

export function getStaticPaths() {
  return orderedTopics.map((topic, index) => ({
    params: { slug: topic.id },
    props: {
      topic,
      prev: orderedTopics[index - 1] ?? null,
      next: orderedTopics[index + 1] ?? null,
    },
  }));
}

const { topic, prev, next } = Astro.props;
const html = renderMarkdown(topic.body);
---

<DocsLayout
  title={`${topic.title} — lab34-flows docs`}
  description={topic.summary}
  activeId={topic.id}
>
  <article>
    <header class="mb-8">
      <p class="mb-2 text-xs font-semibold tracking-wide text-muted-foreground uppercase">
        {topic.categoryLabel}
      </p>
      <h1 class="text-3xl font-semibold tracking-tight">{topic.title}</h1>
      <p class="mt-3 text-lg text-muted-foreground">{topic.summary}</p>
    </header>

    <div class="prose-docs" set:html={html} />
  </article>

  <nav class="mt-12 grid gap-3 border-t border-border pt-6 sm:grid-cols-2">
    {
      prev ? (
        <a
          href={withBase(`/docs/${prev.id}/`)}
          class="group rounded-xl border border-border bg-card p-4 shadow-xs transition-colors hover:bg-accent/40"
        >
          <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
            <Icon name="arrow-left" class="size-3.5" />
            Previous
          </span>
          <span class="mt-1 block font-medium group-hover:underline group-hover:underline-offset-4">
            {prev.title}
          </span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a
          href={withBase(`/docs/${next.id}/`)}
          class="group rounded-xl border border-border bg-card p-4 text-right shadow-xs transition-colors hover:bg-accent/40"
        >
          <span class="flex items-center justify-end gap-1.5 text-xs text-muted-foreground">
            Next
            <Icon name="arrow-right" class="size-3.5" />
          </span>
          <span class="mt-1 block font-medium group-hover:underline group-hover:underline-offset-4">
            {next.title}
          </span>
        </a>
      )
    }
  </nav>
</DocsLayout>
