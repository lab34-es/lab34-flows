---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/help.js';

const features = [
  {
    icon: 'file',
    title: 'Flows are Markdown',
    body: 'A flow is a plain Markdown document with executable step blocks. It lives in your repository, diffs cleanly and travels with your team.',
  },
  {
    icon: 'layout',
    title: 'Notebook-style UI',
    body: 'Press Run and watch each step stream its request, response, assertions and timings right below its block, like a notebook cell.',
  },
  {
    icon: 'app',
    title: 'Applications as code',
    body: 'Callable methods are plain Node.js modules that document themselves with JSDoc — HTTP APIs, MQTT, PostgreSQL, or a browser driven by Playwright.',
  },
  {
    icon: 'bot',
    title: 'AI-assisted authoring',
    body: 'Describe a scenario in plain words and get a validated flow built from your real applications — with Ollama, Gemini or Claude as the provider.',
  },
  {
    icon: 'ticket',
    title: 'Jira / Xray aware',
    body: 'Link a flow to an Xray Test issue from its frontmatter and see its status in the UI. Cloud, Server and Data Center are all supported.',
  },
  {
    icon: 'terminal',
    title: 'CI-friendly CLI',
    body: 'The same flows run headlessly from the command line, so the suite your team reads in the browser is the one your pipeline executes.',
  },
];

const exampleFlow = `---
title: Create and read back
---

# Create and read back

Create a post signed by a random author, then check it exists.

\`\`\`step
application: jsonplaceholder
method: createPost
parameters:
  body:
    title: "{{ randomString }}"
    userId: 1
test:
  status: 201
\`\`\``;
---

<BaseLayout
  title="lab34-flows — executable Markdown for E2E testing"
  description="A UI and CLI tool for testing end-to-end flows: write them as Markdown documents, run them like notebooks, ship them through your pipeline."
>
  <!-- Hero -->
  <section class="border-b border-border">
    <div class="mx-auto w-full max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
      <p
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-border bg-muted px-3 py-1 text-xs font-medium text-muted-foreground"
      >
        <Icon name="zap" class="size-3.5" />
        UI + CLI for end-to-end testing
      </p>
      <h1
        class="max-w-3xl text-4xl font-semibold tracking-tight text-balance sm:text-5xl"
      >
        Executable Markdown for your end-to-end flows
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted-foreground">
        Write a test flow the way you would write a document. Every fenced
        <code class="rounded bg-muted px-1.5 py-0.5 text-sm">step</code> block is executed
        against your own applications, and everything else is documentation.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a
          href={withBase('/docs/')}
          class="inline-flex h-10 items-center gap-2 rounded-md bg-primary px-5 text-sm font-medium text-primary-foreground shadow-xs transition-colors hover:bg-primary/90"
        >
          <Icon name="book-open" />
          Read the docs
        </a>
        <a
          href="https://github.com/lab34-es/lab34-flows"
          class="inline-flex h-10 items-center gap-2 rounded-md border border-border bg-background px-5 text-sm font-medium shadow-xs transition-colors hover:bg-accent hover:text-accent-foreground"
        >
          <Icon name="github" />
          GitHub
        </a>
      </div>
      <div
        class="mt-8 inline-flex items-center gap-3 rounded-lg border border-border bg-muted px-4 py-2.5 font-mono text-sm"
      >
        <span class="select-none text-muted-foreground">$</span>
        <span>npm install -g @lab34/flows</span>
      </div>
    </div>
  </section>

  <!-- Example -->
  <section class="border-b border-border">
    <div
      class="mx-auto grid w-full max-w-6xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:items-center"
    >
      <div>
        <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
          A flow you can read, run and review
        </h2>
        <p class="mt-4 text-muted-foreground">
          Frontmatter carries the metadata, prose carries the intent, and
          <code class="rounded bg-muted px-1.5 py-0.5 text-sm">step</code> blocks carry the
          execution: which application to call, with which parameters, and what to
          assert. Random values, flow memory and mimicked dependencies are one
          template away.
        </p>
        <a
          href={withBase('/docs/flow-anatomy/')}
          class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium underline-offset-4 hover:underline"
        >
          Anatomy of a flow
          <Icon name="arrow-right" class="size-3.5" />
        </a>
      </div>
      <div class="overflow-hidden rounded-xl border border-border bg-card shadow-sm">
        <div
          class="flex items-center gap-2 border-b border-border bg-muted/50 px-4 py-2.5 text-xs font-medium text-muted-foreground"
        >
          <Icon name="file" class="size-3.5" />
          flows/create-and-read-back.md
        </div>
        <pre
          class="overflow-x-auto p-4 font-mono text-[13px] leading-relaxed">{exampleFlow}</pre>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section>
    <div class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
        Everything a test flow needs
      </h2>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((feature) => (
            <div
              class="rounded-xl border border-border bg-card p-6 shadow-xs transition-shadow hover:shadow-sm"
            >
              <div class="mb-4 flex size-9 items-center justify-center rounded-lg bg-muted text-foreground">
                <Icon name={feature.icon} />
              </div>
              <h3 class="font-semibold">{feature.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                {feature.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-border">
    <div
      class="mx-auto flex w-full max-w-6xl flex-col items-start gap-6 px-4 py-16 sm:px-6"
    >
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
        From an empty screen to a running flow in four steps
      </h2>
      <p class="max-w-2xl text-muted-foreground">
        The tool seeds offline examples on first run, so there is something to
        press <em>Run</em> on before you write a single line. The quick start
        walks you through it.
      </p>
      <a
        href={withBase('/docs/quick-start/')}
        class="inline-flex h-10 items-center gap-2 rounded-md bg-primary px-5 text-sm font-medium text-primary-foreground shadow-xs transition-colors hover:bg-primary/90"
      >
        <Icon name="rocket" />
        Quick start
      </a>
    </div>
  </section>
</BaseLayout>
