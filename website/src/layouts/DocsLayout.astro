---
import BaseLayout from './BaseLayout.astro';
import DocsNav from '../components/DocsNav.astro';

const { title, description, activeId = null, ogType = 'website', jsonLd = null } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogType={ogType}
  jsonLd={jsonLd}
  navTag="docs"
  wide
>
  <div class="fl-docs-shell">
    <aside class="fl-docs-aside">
      <!-- Narrow screens: the same tree, folded away above the article. -->
      <details class="fl-docs-menu">
        <summary>documentation menu</summary>
        <div class="fl-docs-menu-body">
          <DocsNav activeId={activeId} />
        </div>
      </details>
      <div class="fl-docs-tree">
        <DocsNav activeId={activeId} />
      </div>
    </aside>

    <div class="fl-docs-main">
      <slot />
    </div>
  </div>
</BaseLayout>
