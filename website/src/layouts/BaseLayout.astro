---
import '../styles/global.css';
import { withBase } from '../lib/help.js';
import Icon from '../components/Icon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const { title, description, ogType = 'website', jsonLd = null } = Astro.props;
const repoUrl = 'https://github.com/lab34-es/lab34-flows';

// Absolute, trailing-slash canonical URL of this page.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(withBase('/og-image.png'), Astro.site).href;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="lab34-flows" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="lab34-flows — executable Markdown for end-to-end testing" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      const theme =
        localStorage.getItem('theme') ??
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>
  </head>
  <body class="flex min-h-svh flex-col font-sans">
    <header
      class="sticky top-0 z-40 border-b border-border bg-background/80 backdrop-blur"
    >
      <div class="mx-auto flex h-14 w-full max-w-6xl items-center gap-6 px-4 sm:px-6">
        <a href={withBase('/')} class="flex items-center gap-2 font-semibold tracking-tight">
          <span
            class="flex size-6 items-center justify-center rounded-md bg-primary text-primary-foreground"
          >
            <Icon name="workflow" class="size-3.5" />
          </span>
          lab34-flows
        </a>
        <nav class="flex items-center gap-1 text-sm">
          <a
            href={withBase('/docs/')}
            class="rounded-md px-3 py-1.5 font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
          >
            Docs
          </a>
        </nav>
        <div class="ml-auto flex items-center gap-1">
          <a
            href={repoUrl}
            aria-label="GitHub repository"
            class="inline-flex size-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
          >
            <Icon name="github" />
          </a>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-border">
      <div
        class="mx-auto flex w-full max-w-6xl flex-col gap-2 px-4 py-8 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between sm:px-6"
      >
        <p>
          MIT licensed. Built for testing E2E flows.
        </p>
        <p>
          <a href={repoUrl} class="font-medium hover:text-foreground">GitHub</a>
          <span class="mx-2">·</span>
          <a href={`${repoUrl}/issues`} class="font-medium hover:text-foreground">Issues</a>
        </p>
      </div>
    </footer>
  </body>
</html>
